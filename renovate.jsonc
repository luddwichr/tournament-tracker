{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "1 day",
  // Only rebase a PR when it actually conflicts with main.
  // The default rebases every open PR whenever main moves.
  // In cases where main is updated frequently, several full CI runs on identical content are run before the update
  // PR is merged.
  // The cost of the narrower setting is that a PR's checks reflect its own merge base rather than the newest main,
  // which the required checks on merge still catch.
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      // Patch bumps are frequent and low-risk, so they share one PR instead of one each.
      // This rule comes first on purpose, because the dedicated groups below override it for their own packages.
      "groupName": "patch dependencies",
      "matchUpdateTypes": ["patch"],
    },
    {
      "groupName": "playwright",
      "matchPackageNames": ["playwright", "@playwright/test"],
    },
    {
      // Matches every manager on purpose, so .nvmrc, the Dockerfile ARG and engines.node in package.json
      // all move in a single PR.
      "groupName": "node",
      "matchDepNames": ["node"],
    },
    {
      "groupName": "npm",
      "matchDepNames": ["npm"],
    },
    {
      "groupName": "opengrep",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["opengrep"],
    },
    {
      "groupName": "gitleaks",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["gitleaks"],
    },
    {
      "groupName": "zizmor",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["zizmor"],
    },
    {
      "groupName": "trivy",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["trivy"],
    },
    {
      // renovate-the-CLI ships multiple releases a day; without a schedule the
      // exact pin below would otherwise get a bump PR almost every day.
      "groupName": "renovate-cli",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["renovate"],
      "extends": ["schedule:monthly"],
    },
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG NODE_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG NPM_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG UV_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "uv",
      "packageNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG PYTHON_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG PLAYWRIGHT_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "playwright",
      "datasourceTemplate": "npm",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG OPENGREP_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "opengrep",
      "packageNameTemplate": "opengrep/opengrep",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["OPENGREP_VERSION: (?<currentValue>[\\d.]+)"],
      "depNameTemplate": "opengrep",
      "packageNameTemplate": "opengrep/opengrep",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG GITLEAKS_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "gitleaks",
      "packageNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["GITLEAKS_VERSION: (?<currentValue>[\\d.]+)"],
      "depNameTemplate": "gitleaks",
      "packageNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG ZIZMOR_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "zizmor",
      "packageNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["ZIZMOR_VERSION: (?<currentValue>[\\d.]+)"],
      "depNameTemplate": "zizmor",
      "packageNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG TRIVY_VERSION=(?<currentValue>.*)"],
      "depNameTemplate": "trivy",
      "packageNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["TRIVY_VERSION: (?<currentValue>[\\d.]+)"],
      "depNameTemplate": "trivy",
      "packageNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["--package renovate@(?<currentValue>[\\d.]+) -- renovate-config-validator"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
    },
  ],
}
