{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
  ],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "1 day",
  // Only rebase a PR when it actually conflicts with main.
  // The default rebases every open PR whenever main moves.
  // In cases where main is updated frequently, several full CI runs on identical content are run before the update
  // PR is merged.
  // The cost of the narrower setting is that a PR's checks reflect its own merge base rather than the newest main,
  // which the required checks on merge still catch.
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      // Patch bumps are frequent and low-risk, so they share one PR instead of one each.
      // This rule comes first on purpose, because the dedicated groups below override it for their own packages.
      "groupName": "patch dependencies",
      "matchUpdateTypes": ["patch"],
    },
    {
      "groupName": "playwright",
      "matchPackageNames": ["playwright", "@playwright/test"],
    },
    {
      // Matches every manager on purpose, so .nvmrc, the Dockerfile ARG and engines.node in package.json
      // all move in a single PR.
      "groupName": "node",
      "matchDepNames": ["node"],
    },
    {
      "groupName": "npm",
      "matchDepNames": ["npm"],
    },
    {
      "groupName": "opengrep",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["opengrep"],
    },
    {
      "groupName": "gitleaks",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["gitleaks"],
    },
    {
      "groupName": "zizmor",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["zizmor"],
    },
    {
      "groupName": "trivy",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["trivy"],
    },
    {
      // renovate-the-CLI ships multiple releases a day; without a schedule the
      // exact pin below would otherwise get a bump PR almost every day.
      "groupName": "renovate-cli",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["renovate"],
      "extends": ["schedule:monthly"],
    },
  ],
  // The tool pins in .devcontainer/Dockerfile and .github/workflows/ci.yml are found by the
  // customManagers:dockerfileVersions and customManagers:githubActionsVersions presets in "extends".
  // Each pin carries a "# renovate:" comment on the line directly above it, naming its datasource and package.
  // This one has no _VERSION variable, so no preset covers it.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["--package renovate@(?<currentValue>[\\d.]+) -- renovate-config-validator"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
    },
  ],
}
